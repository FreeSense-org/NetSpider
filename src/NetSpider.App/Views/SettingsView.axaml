<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSpider.App.ViewModels"
             x:Class="NetSpider.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Width" Value="220" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="StackPanel.row">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Width" Value="140" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Margin" Value="0,2" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#0A1020" BorderBrush="{StaticResource BorderBrushNeon}" BorderThickness="0,1,0,0" Padding="18,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" Foreground="{StaticResource GreenBrush}" />
          <TextBlock Text="{Binding SettingsPath}" Classes="caption mono" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Command="{Binding OpenDataFolderCommand}" Content="Open data folder" />
          <Button Classes="ghost" Command="{Binding RevertCommand}" Content="Revert lists" />
          <Button Classes="accent" Command="{Binding SaveCommand}" Content="Save settings" MinWidth="130" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="18,14,22,18" Spacing="14" MaxWidth="1100" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Classes="h1" />

        <!-- ===== updates (built-in updater) ===== -->
        <ContentControl Content="{Binding Updates}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:UpdateSettingsViewModel">
              <Border Classes="card">
                <Border.Styles>
                  <Style Selector="Border.segmented:disabled">
                    <Setter Property="Opacity" Value="0.5" />
                  </Style>
                  <Style Selector="Path.spin">
                    <Setter Property="RenderTransform" Value="rotate(0deg)" />
                    <Style.Animations>
                      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                      </Animation>
                    </Style.Animations>
                  </Style>
                </Border.Styles>
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="UPDATES" Classes="section" Margin="0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" Classes="caption" VerticalAlignment="Center" />
                  </Grid>

                  <!-- install mode -->
                  <Border Classes="banner info" Margin="0,0,0,8" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*">
                      <Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,0,0" />
                      <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                        <TextBlock Text="{Binding InstallModeName}" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Text="{Binding InstallModeText}" TextWrapping="Wrap" FontSize="12" Classes="dim" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <CheckBox IsChecked="{Binding Settings.UpdateCheckOnStartup}" IsEnabled="{Binding CanCheck}" Content="Check for updates when NetSpider starts" />
                  <StackPanel Classes="row">
                    <TextBlock Classes="label" Text="Check every (hours, 0 = off)" />
                    <NumericUpDown Value="{Binding CheckHours}" Minimum="0" Maximum="168" Increment="1" FormatString="0" IsEnabled="{Binding CanCheck}" />
                    <TextBlock Text="{Binding CheckHoursHint}" Classes="caption" VerticalAlignment="Center" Margin="10,0,0,0" />
                  </StackPanel>
                  <StackPanel Classes="row">
                    <TextBlock Classes="label" Text="Channel" />
                    <StackPanel VerticalAlignment="Center">
                      <CheckBox IsChecked="{Binding IncludePrereleases}" IsEnabled="{Binding CanCheck}" Content="Also receive pre-releases"
                                ToolTip.Tip="Release: tested versions only. Pre-release: new features earlier — you also get every release." />
                      <TextBlock Classes="caption" Text="Off: Release channel (tested versions). On: Pre-release channel (early builds plus every release)." />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Classes="row">
                    <TextBlock Classes="label" Text="When an update is found" />
                    <Border Classes="segmented" IsEnabled="{Binding CanSelfUpdate}">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="seg" GroupName="updAction" Content="Notify only" IsChecked="{Binding IsNotifyOnly}"
                                     ToolTip.Tip="Show the update chip and a notification; nothing is downloaded" />
                        <RadioButton Classes="seg" GroupName="updAction" Content="Download, then ask" IsChecked="{Binding IsDownloadAndAsk}"
                                     ToolTip.Tip="Download in the background, then ask to restart" />
                        <RadioButton Classes="seg" GroupName="updAction" Content="Install when I exit" IsChecked="{Binding IsInstallOnExit}"
                                     ToolTip.Tip="Download in the background and install silently when NetSpider closes" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding ActionHint}" IsVisible="{Binding HasActionHint}" Classes="caption" Margin="220,0,0,4" />
                  <StackPanel Classes="row">
                    <TextBlock Classes="label" Text="Skipped version" />
                    <TextBlock Text="none" Classes="faint" VerticalAlignment="Center" IsVisible="{Binding !HasSkipped}" />
                    <Border Classes="pill" Background="#22FFC23D" BorderBrush="#66FFC23D" Padding="8,2" IsVisible="{Binding HasSkipped}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SkippedVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" />
                    </Border>
                    <Button Classes="ghost" Content="Clear" Padding="10,3" Margin="8,0,0,0" Command="{Binding ClearSkippedCommand}" IsVisible="{Binding HasSkipped}"
                            ToolTip.Tip="Remind me about this version again" />
                  </StackPanel>

                  <TextBlock Text="{Binding LastChecked}" Classes="dim" FontSize="12.5" Margin="0,8,0,8" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Classes="accent" Margin="0,0,8,6" Command="{Binding CheckNowCommand}" MinWidth="130">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Width="13" Height="13">
                          <Path Classes="icon" Data="{StaticResource IconRefresh}" Stroke="#B9F9FF" StrokeThickness="1.8" Stretch="Uniform" IsVisible="{Binding !IsChecking}" />
                          <Path Classes="spin" Data="M12,3 A9,9 0 1 1 3,12" Stroke="#B9F9FF" StrokeThickness="2.2" StrokeLineCap="Round" Stretch="Uniform" IsVisible="{Binding IsChecking}" />
                        </Panel>
                        <TextBlock Text="Check now" />
                      </StackPanel>
                    </Button>
                    <Button Classes="ghost" Margin="0,0,8,6" Content="Show what's new" Command="{Binding ShowWhatsNewCommand}" ToolTip.Tip="The changes in the installed version" />
                    <Button Classes="ghost" Margin="0,0,8,6" Content="View release notes" Command="{Binding ViewReleaseNotesCommand}" ToolTip.Tip="Opens the releases page" />
                    <Button Classes="pill" Margin="0,0,8,6" Padding="12,6" Background="#22FFC23D" BorderBrush="#88FFC23D" IsVisible="{Binding ShowOpenUpdate}" Command="{Binding OpenUpdateCommand}">
                      <TextBlock Text="{Binding OpenUpdateText}" Foreground="{StaticResource AmberBrush}" FontWeight="SemiBold" />
                    </Button>
                  </WrapPanel>
                  <CheckBox IsChecked="{Binding RemoveDataOnUninstall}" IsEnabled="{Binding IsSetup}" Margin="0,8,0,0"
                            Content="Remove my data when uninstalling (settings, history, captures and logs)"
                            ToolTip.Tip="Off: uninstalling keeps %LOCALAPPDATA%\NetSpider so a reinstall picks up where you left off" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- scanning -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Text="SCANNING" Classes="section" Margin="0,0,0,6" />
            <WrapPanel>
              <CheckBox IsChecked="{Binding Settings.ScanOtherSubnets}" Content="Scan other subnets" Width="250" />
              <CheckBox IsChecked="{Binding Settings.ProbeVlans}" Content="Probe VLANs (tagged ARP)" Width="250" />
              <CheckBox IsChecked="{Binding Settings.TlsInspection}" Content="TLS certificate inspection" Width="250" />
              <CheckBox IsChecked="{Binding Settings.BannerGrab}" Content="Banner grabbing" Width="250" />
              <CheckBox IsChecked="{Binding Settings.Traceroute}" Content="Traceroute" Width="250" />
              <CheckBox IsChecked="{Binding Settings.ActiveDhcpDiscover}" Content="Active DHCP discover (rogue check)" Width="250" />
              <CheckBox IsChecked="{Binding Settings.IgmpQuery}" Content="IGMP / MLD general query" Width="250" />
            </WrapPanel>
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Port scan profile" /><ComboBox ItemsSource="{Binding PortScanProfiles}" SelectedItem="{Binding Settings.PortScan}" Width="160" /></StackPanel>
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Extra ports" /><TextBox Text="{Binding Settings.ExtraPorts}" Width="300" Watermark="e.g. 8000-8100,9999" /></StackPanel>
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Largest subnet to sweep (/prefix)" /><NumericUpDown Value="{Binding MinSweepPrefix}" Minimum="8" Maximum="30" Increment="1" FormatString="0" /></StackPanel>
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Max injected packets / s" /><NumericUpDown Value="{Binding MaxInjectPps}" Minimum="10" Maximum="20000" Increment="50" FormatString="0" /></StackPanel>
          </StackPanel>
        </Border>

        <!-- application (startup, tray, notifications, logging, captures, maintenance) -->
        <Border Classes="card">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="APPLICATION" Classes="section" Margin="0,0,0,6" />
              <Button Grid.Column="1" Classes="link" Content="Show welcome again" Command="{Binding ShowWelcomeCommand}" FontSize="12" VerticalAlignment="Center"
                      ToolTip.Tip="Open the first-run wizard (Npcap, adapter, preferences)" />
            </Grid>
            <Grid ColumnDefinitions="*,*">
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Startup" Classes="caption" Margin="0,0,0,2" />
                <CheckBox IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding !IsBusyApp}" Content="Start with Windows" />
                <TextBlock Text="{Binding StartWithWindowsHint}" Classes="caption" TextWrapping="Wrap" Margin="28,0,0,4" FontSize="11" />
                <CheckBox IsChecked="{Binding Settings.StartMinimizedToTray}" Content="Start minimized to the tray" />
                <CheckBox IsChecked="{Binding Settings.CloseToTray}" Content="Close button minimizes to the tray" />
                <CheckBox IsChecked="{Binding Settings.AutoStartMonitoring}" Content="Start monitoring on launch (last adapter)" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Desktop notifications" Classes="caption" Margin="0,0,0,2" />
                <CheckBox IsChecked="{Binding Settings.ToastNotifications}" Content="Windows notifications while NetSpider is minimized or in the tray" />
                <StackPanel Classes="row" IsEnabled="{Binding Settings.ToastNotifications}">
                  <TextBlock Classes="label" Text="Minimum severity" Width="160" />
                  <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Settings.ToastMinSeverity}" Width="140" />
                </StackPanel>
                <TextBlock Text="Logging &amp; storage" Classes="caption" Margin="0,10,0,0" />
                <StackPanel Classes="row">
                  <TextBlock Classes="label" Text="Log level" Width="160" />
                  <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" Width="140"
                            ToolTip.Tip="Debug logs much more detail (for troubleshooting); applies immediately" />
                </StackPanel>
                <StackPanel Classes="row">
                  <TextBlock Classes="label" Text="Captures folder limit (MB)" Width="160" />
                  <NumericUpDown Value="{Binding CaptureFolderMaxMb}" Minimum="100" Maximum="1048576" Increment="256" FormatString="0" Width="140"
                                 ToolTip.Tip="Oldest .pcapng captures are deleted beyond this size (checked hourly)" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <Border Height="1" Background="{StaticResource BorderBrushNeon}" Margin="0,12,0,10" />
            <WrapPanel>
              <Button Classes="ghost" Command="{Binding ExportSettingsCommand}" Content="Export settings…" Margin="0,0,8,6" ToolTip.Tip="Save all settings to a JSON file" />
              <Button Classes="ghost" Command="{Binding ImportSettingsCommand}" Content="Import settings…" Margin="0,0,8,6" ToolTip.Tip="Load settings from an exported JSON file" />
              <Button Classes="ghost" Command="{Binding OpenCapturesFolderCommand}" Content="Open captures folder" Margin="0,0,8,6" ToolTip.Tip="{Binding CapturesPath}" />
              <Button Classes="ghost" Command="{Binding OpenLogsFolderCommand}" Content="Open logs folder" Margin="0,0,20,6" />
              <Button Classes="danger" Command="{Binding ResetSettingsCommand}" Content="Reset all settings…" Margin="0,0,8,6" />
              <Button Classes="danger" Command="{Binding ClearHistoryCommand}" Content="Clear device history and incidents…" Margin="0,0,8,6" IsEnabled="{Binding !IsBusyApp}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="{Binding AppStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{StaticResource CyanBrush}" Width="14" Height="14" IsVisible="{Binding !AppStatusIsError}" />
              <Path Classes="icon" Data="{StaticResource IconWarn}" Stroke="{StaticResource RedBrush}" Width="14" Height="14" IsVisible="{Binding AppStatusIsError}" />
              <SelectableTextBlock Text="{Binding AppStatus}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="980" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- SNMP -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Text="SNMP" Classes="section" Margin="0,0,0,6" />
            <TextBlock Text="v1/v2c communities (tried in order)" Classes="caption" />
            <ItemsControl ItemsSource="{Binding Communities}" Margin="0,6">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EditableString">
                  <Border Classes="chip" Background="#1A00E5FF" BorderBrush="#5500E5FF" Padding="4,2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBox Text="{Binding Value}" MinWidth="90" BorderThickness="0" Background="Transparent" Padding="4,2" FontSize="12.5" />
                      <Button Classes="icon" Padding="4" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveCommunityCommand}" CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource IconClose}" Width="9" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Text="{Binding NewCommunity}" Width="200" Watermark="Add community…" />
              <Button Classes="ghost" Command="{Binding AddCommunityCommand}" Content="Add" />
            </StackPanel>
            <TextBlock Text="SNMPv3" Classes="caption" Margin="0,12,0,4" />
            <StackPanel Classes="row"><TextBlock Classes="label" Text="User" /><TextBox Text="{Binding Settings.SnmpV3User}" Width="240" /></StackPanel>
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Auth protocol / password" />
              <ComboBox ItemsSource="{Binding AuthProtocols}" SelectedItem="{Binding Settings.SnmpV3AuthProtocol}" Width="110" />
              <TextBox Text="{Binding Settings.SnmpV3AuthPassword}" PasswordChar="●" Width="220" Margin="8,0,0,0" /></StackPanel>
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Privacy protocol / password" />
              <ComboBox ItemsSource="{Binding PrivProtocols}" SelectedItem="{Binding Settings.SnmpV3PrivProtocol}" Width="110" />
              <TextBox Text="{Binding Settings.SnmpV3PrivPassword}" PasswordChar="●" Width="220" Margin="8,0,0,0" /></StackPanel>
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Timeout (ms)" /><NumericUpDown Value="{Binding SnmpTimeoutMs}" Minimum="200" Maximum="10000" Increment="100" FormatString="0" /></StackPanel>
            <CheckBox IsChecked="{Binding Settings.SnmpAutoPoll}" Content="Auto-poll SNMP devices while monitoring (try new devices, re-poll responders)" Margin="0,8,0,2" />
            <StackPanel Classes="row" IsEnabled="{Binding Settings.SnmpAutoPoll}"><TextBlock Classes="label" Text="Re-poll every (minutes)" /><NumericUpDown Value="{Binding SnmpPollMinutes}" Minimum="1" Maximum="1440" Increment="1" FormatString="0" /></StackPanel>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*">
          <!-- latency -->
          <Border Classes="card" Margin="0,0,7,0">
            <StackPanel>
              <TextBlock Text="LATENCY" Classes="section" Margin="0,0,0,6" />
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Probe interval (s)" /><NumericUpDown Value="{Binding LatencyIntervalSeconds}" Minimum="1" Maximum="10" FormatString="0" /></StackPanel>
              <CheckBox IsChecked="{Binding Settings.TcpLatency}" Content="Also measure TCP RTT" />
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Good below (ms) — green" /><NumericUpDown Value="{Binding LatencyGoodMs}" Minimum="0.1" Maximum="100" Increment="0.5" FormatString="0.0" /></StackPanel>
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Warn below (ms) — yellow" /><NumericUpDown Value="{Binding LatencyWarnMs}" Minimum="0.5" Maximum="500" Increment="1" FormatString="0.0" /></StackPanel>
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Bad above (ms) — red" /><NumericUpDown Value="{Binding LatencyBadMs}" Minimum="1" Maximum="2000" Increment="5" FormatString="0.0" /></StackPanel>
            </StackPanel>
          </Border>
          <!-- anomaly -->
          <Border Grid.Column="1" Classes="card" Margin="7,0,0,0">
            <StackPanel>
              <TextBlock Text="ANOMALY THRESHOLDS" Classes="section" Margin="0,0,0,6" />
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Broadcast storm (% of packets)" /><NumericUpDown Value="{Binding StormBroadcastPercent}" Minimum="1" Maximum="100" FormatString="0" /></StackPanel>
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Broadcast storm (pps)" /><NumericUpDown Value="{Binding StormBroadcastPps}" Minimum="10" Maximum="100000" Increment="50" FormatString="0" /></StackPanel>
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Multicast storm (pps)" /><NumericUpDown Value="{Binding StormMulticastPps}" Minimum="10" Maximum="100000" Increment="100" FormatString="0" /></StackPanel>
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Per-MAC storm (pps)" /><NumericUpDown Value="{Binding StormPerMacPps}" Minimum="10" Maximum="100000" Increment="50" FormatString="0" /></StackPanel>
              <StackPanel Classes="row"><TextBlock Classes="label" Text="MAC flap threshold" /><NumericUpDown Value="{Binding MacFlapThreshold}" Minimum="1" Maximum="100" FormatString="0" /></StackPanel>
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Top talker (pps)" /><NumericUpDown Value="{Binding TopTalkerPps}" Minimum="10" Maximum="1000000" Increment="100" FormatString="0" /></StackPanel>
              <CheckBox IsChecked="{Binding Settings.DumpPcapOnAlert}" Content="Dump pcapng on alert" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- internet monitor -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Text="INTERNET MONITOR" Classes="section" Margin="0,0,0,6" />
            <CheckBox IsChecked="{Binding Settings.InternetMonitorEnabled}" Content="Monitor internet connectivity (pings your targets continuously — off by default)" />
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Declare offline after (failed rounds)" /><NumericUpDown Value="{Binding InternetOutageRounds}" Minimum="1" Maximum="60" FormatString="0" /></StackPanel>
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Degraded above (ms)" /><NumericUpDown Value="{Binding InternetLatencyWarnMs}" Minimum="5" Maximum="5000" Increment="10" FormatString="0" /></StackPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Ping targets (any number of IPs or host names) and the interval are edited on the Internet page." />
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*">
          <!-- path doctor -->
          <Border Classes="card" Margin="0,0,7,0">
            <StackPanel>
              <TextBlock Text="PATH DOCTOR" Classes="section" Margin="0,0,0,6" />
              <CheckBox IsChecked="{Binding Settings.PathMonitorEnabled}" Content="Probe every hop from this PC to the internet continuously" />
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Probe interval (s)" /><NumericUpDown Value="{Binding PathIntervalSeconds}" Minimum="1" Maximum="60" FormatString="0" /></StackPanel>
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Hop down after (failed rounds)" /><NumericUpDown Value="{Binding HopDownRounds}" Minimum="1" Maximum="30" FormatString="0" /></StackPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="The fault locator turns failing hops into incidents with a root cause. Lower rounds react faster but can flag a single lost ping." />
            </StackPanel>
          </Border>
          <!-- switch ports -->
          <Border Grid.Column="1" Classes="card" Margin="7,0,0,0">
            <StackPanel>
              <TextBlock Text="SWITCH-PORT DIAGNOSTICS" Classes="section" Margin="0,0,0,6" />
              <CheckBox IsChecked="{Binding Settings.PortCountersEnabled}" Content="Poll SNMP port counters (errors, CRC/FCS, flaps, duplex)" />
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Poll every (s)" /><NumericUpDown Value="{Binding PortCounterPollSeconds}" Minimum="10" Maximum="3600" Increment="10" FormatString="0" /></StackPanel>
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Warn above (errors / min)" /><NumericUpDown Value="{Binding PortErrorsPerMinWarn}" Minimum="0.1" Maximum="100000" Increment="1" FormatString="0.#" /></StackPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="Needs SNMP access to managed switches (see SNMP above). Problem ports turn amber/red in the Port Matrix." />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="*,*">
          <!-- storm center -->
          <Border Classes="card" Margin="0,0,7,0">
            <StackPanel>
              <TextBlock Text="STORM CENTER" Classes="section" Margin="0,0,0,6" />
              <CheckBox IsChecked="{Binding Settings.StormControlCheckEnabled}" Content="Allow the storm-control check (active test)" />
              <Border Classes="banner warn" Margin="0,8,0,0" Padding="12,8">
                <Grid ColumnDefinitions="Auto,*">
                  <Path Classes="icon" Data="{StaticResource IconWarn}" Stroke="{StaticResource AmberBrush}" Width="15" Height="15" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" FontSize="12"
                             Text="The check deliberately sends a broadcast burst (up to 5 000 pps for 5 s) on your network and may briefly disturb other devices. It only ever runs when you press the button on the Storm Center page, after a confirmation." />
                </Grid>
              </Border>
              <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,8,0,0"
                         Text="Storm thresholds (pps / %) are under Anomaly thresholds above." />
            </StackPanel>
          </Border>
          <!-- wi-fi -->
          <Border Grid.Column="1" Classes="card" Margin="7,0,0,0">
            <StackPanel>
              <TextBlock Text="WI-FI DIAGNOSTICS" Classes="section" Margin="0,0,0,6" />
              <CheckBox IsChecked="{Binding Settings.WifiLinkMonitorEnabled}" Content="Record this PC's Wi-Fi link (RSSI, rates, roams, disconnect reasons)" />
              <StackPanel Classes="row"><TextBlock Classes="label" Text="Weak signal below (dBm)" /><NumericUpDown Value="{Binding WifiWeakRssiDbm}" Minimum="-95" Maximum="-40" Increment="1" FormatString="0" /></StackPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="Per-AP health (management IP + client reachability) also works from a wired PC." />
            </StackPanel>
          </Border>
        </Grid>

        <!-- probe agents -->
        <Border Classes="card">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="PROBE AGENTS" Classes="section" Margin="0,0,0,6" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{Binding Agents.HubBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Agents.HubStatus}" Classes="dim" FontSize="12" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Run NetSpider.Probe on a second PC, laptop or Raspberry Pi to test the network from another vantage point (e.g. LAN → Wi-Fi and Wi-Fi → LAN). Reports are HMAC-signed with the shared key." />
            <CheckBox IsChecked="{Binding Agents.HubEnabled}" Content="Accept reports from probe agents (UDP hub)" />
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Hub port (UDP)" /><NumericUpDown Value="{Binding Agents.Port}" Minimum="1024" Maximum="65535" FormatString="0" /></StackPanel>
            <StackPanel Classes="row">
              <TextBlock Classes="label" Text="Shared key" />
              <Border Background="#0A1020" BorderBrush="{StaticResource BorderBrushNeon}" BorderThickness="1" CornerRadius="9" Padding="10,6" Width="300">
                <TextBlock Text="{Binding Agents.KeyDisplay}" Classes="mono" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Border>
              <ToggleButton IsChecked="{Binding Agents.ShowKey}" Content="Show" Margin="8,0,0,0" />
              <Button Classes="ghost" Command="{Binding Agents.CopyKeyCommand}" Margin="6,0,0,0" ToolTip.Tip="Copy the key">
                <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconCopy}" Width="12" /><TextBlock Text="Copy" /></StackPanel>
              </Button>
              <Button Classes="ghost" Command="{Binding Agents.RegenerateKeyCommand}" Margin="6,0,0,0" Content="Regenerate" ToolTip.Tip="Generate a new key (agents must be restarted with it)" />
            </StackPanel>
            <TextBlock Text="Start an agent with:" Classes="caption" Margin="0,8,0,4" />
            <Grid ColumnDefinitions="*,Auto">
              <Border Background="#05080F" BorderBrush="{StaticResource BorderBrushNeon}" BorderThickness="1" CornerRadius="9" Padding="12,8">
                <SelectableTextBlock Text="{Binding Agents.ExampleCommand}" Classes="mono" Foreground="#7FEFFF" TextWrapping="Wrap" />
              </Border>
              <Button Grid.Column="1" Classes="accent" Command="{Binding Agents.CopyCommandCommand}" Margin="8,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconCopy}" Width="12" /><TextBlock Text="Copy command" /></StackPanel>
              </Button>
            </Grid>
            <TextBlock Text="{Binding Agents.Message}" Classes="dim" FontSize="12" Margin="0,6,0,0" IsVisible="{Binding Agents.Message, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <TextBlock Text="Agents" Classes="caption" Margin="0,12,0,4" />
            <TextBlock Text="No remote agents have reported yet." Classes="dim" IsVisible="{Binding !Agents.HasRemote}" />
            <Grid ColumnDefinitions="24,170,130,80,90,*" Margin="0,0,0,4" IsVisible="{Binding Agents.HasRemote}">
              <TextBlock Grid.Column="1" Text="Host" Classes="th" />
              <TextBlock Grid.Column="2" Text="IP" Classes="th" />
              <TextBlock Grid.Column="3" Text="Medium" Classes="th" />
              <TextBlock Grid.Column="4" Text="Last seen" Classes="th" />
              <TextBlock Grid.Column="5" Text="Results" Classes="th" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Agents.Remote}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AgentRow">
                  <Grid ColumnDefinitions="24,170,130,80,90,*" Margin="0,4">
                    <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip.Tip="{Binding StateText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Hostname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Ip}" Classes="mono" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Medium}" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding LastSeen}" FontSize="12.5" Classes="dim" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="5" ItemsSource="{Binding Targets}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AgentTargetRow">
                          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Target}" Classes="caption" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Value}" Foreground="{Binding Brush}" FontSize="11.5" FontWeight="SemiBold" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Agents.BuiltInText}" Classes="caption" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- logos -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Text="LOGOS" Classes="section" Margin="0,0,0,6" />
            <CheckBox IsChecked="{Binding Settings.ScrapeVendorLogos}" Content="Scrape vendor logos from vendor websites (cached locally)" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
              <Button Classes="accent" Command="{Binding PrefetchLogosCommand}" Content="Prefetch all logos" ToolTip.Tip="{Binding PrefetchTooltip}" ToolTip.ShowOnDisabled="True" />
              <Button Classes="ghost" Command="{Binding CancelPrefetchCommand}" Content="Cancel" IsVisible="{Binding IsPrefetching}" />
              <ProgressBar Value="{Binding PrefetchProgress}" Maximum="100" Width="240" Height="6" MinHeight="6" VerticalAlignment="Center" IsVisible="{Binding IsPrefetching}" />
              <TextBlock Text="{Binding PrefetchText}" Classes="dim" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- notifications -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Text="NOTIFICATIONS" Classes="section" Margin="0,0,0,6" />
            <StackPanel Classes="row"><TextBlock Classes="label" Text="Minimum severity" /><ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Settings.NotifyMinSeverity}" Width="160" /></StackPanel>
            <TextBlock Text="Webhooks" Classes="caption" Margin="0,8,0,4" />
            <ItemsControl ItemsSource="{Binding Webhooks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WebhookItem">
                  <Grid ColumnDefinitions="Auto,160,120,*,Auto" Margin="0,3">
                    <CheckBox IsChecked="{Binding Enabled}" />
                    <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="Name" Margin="4,0" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).WebhookKinds}" SelectedItem="{Binding Kind}" Margin="4,0" HorizontalAlignment="Stretch" />
                    <TextBox Grid.Column="3" Text="{Binding Url}" Watermark="https://…" Margin="4,0" />
                    <Button Grid.Column="4" Classes="icon" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveWebhookCommand}" CommandParameter="{Binding}">
                      <Path Classes="icon" Data="{StaticResource IconClose}" Width="11" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="ghost" Command="{Binding AddWebhookCommand}" Content="+ Add webhook" Margin="0,6,0,0" />
            <StackPanel Classes="row" Margin="0,12,0,0"><TextBlock Classes="label" Text="Syslog server : port" />
              <TextBox Text="{Binding Settings.SyslogServer}" Width="220" Watermark="host or IP" />
              <NumericUpDown Value="{Binding SyslogPort}" Minimum="1" Maximum="65535" FormatString="0" Margin="8,0,0,0" Width="120" /></StackPanel>
          </StackPanel>
        </Border>

        <!-- UI -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Text="USER INTERFACE" Classes="section" Margin="0,0,0,6" />
            <CheckBox IsChecked="{Binding Settings.ShowMacOnNodes}" Content="Show MAC addresses on graph nodes" />
            <CheckBox IsChecked="{Binding Settings.ShowEstimatedLinks}" Content="Show estimated / inferred links and latencies" />
            <CheckBox IsChecked="{Binding Settings.Animations}" Content="Animations (pulses, particles, packet rain)" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
