<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSpider.App.ViewModels"
             xmlns:c="using:NetSpider.App.Controls"
             x:Class="NetSpider.App.Views.IncidentsView"
             x:DataType="vm:IncidentsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18,14,22,18" Spacing="14">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Incidents" Classes="h1" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding ActiveCount, StringFormat='{}{0} ongoing'}" Foreground="{StaticResource RedBrush}" FontSize="12" />
            <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} total'}" Classes="dim" FontSize="12" />
            <TextBlock Text="Correlated failures with a root-cause hypothesis — which device or link broke." Classes="caption" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="170" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ToggleSwitch Grid.Column="2" IsChecked="{Binding ActiveOnly}" OnContent="Active only" OffContent="Active only" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button Grid.Column="3" Classes="danger" Command="{Binding ClearCommand}" Content="Clear closed" VerticalAlignment="Center"
                ToolTip.Tip="Remove closed incidents (ongoing ones stay)" />
      </Grid>

      <Border Classes="banner info" Margin="0" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      </Border>

      <Border Classes="card" IsVisible="{Binding IsEmpty}" Padding="24">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource GreenBrush}" StrokeThickness="2" Width="40" Height="40" Stretch="Uniform" />
          <TextBlock Text="{Binding EmptyTitle}" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyText}" Classes="dim" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="640" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- timeline -->
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:IncidentRow">
            <Grid ColumnDefinitions="96,26,*">
              <StackPanel HorizontalAlignment="Right" Margin="0,14,10,0">
                <TextBlock Text="{Binding StartText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Classes="mono" />
                <TextBlock Text="{Binding StartDate}" Classes="caption" HorizontalAlignment="Right" />
              </StackPanel>
              <Panel Grid.Column="1">
                <Rectangle Width="2" Fill="#1E2B47" HorizontalAlignment="Center" />
                <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Accent}" Opacity="0.3" VerticalAlignment="Top" Margin="0,15,0,0"
                        Classes="pulse" IsVisible="{Binding Ongoing}" />
                <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Accent}" VerticalAlignment="Top" Margin="0,18,0,0"
                        BorderBrush="#070B14" BorderThickness="3" />
              </Panel>
              <Border Grid.Column="2" Classes="card" Padding="16,12" Margin="10,6,0,6" BorderBrush="{Binding AccentSoft}" Background="{Binding CardBackground}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="36" Height="36" CornerRadius="10" Background="#0A1020" BorderBrush="{Binding AccentSoft}" BorderThickness="1" VerticalAlignment="Top">
                    <Path Classes="icon" Data="{Binding CategoryIcon}" Stroke="{Binding Accent}" Width="18" Height="18" HorizontalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="badge" Background="#26FF3D5A" BorderBrush="{StaticResource RedBrush}" IsVisible="{Binding Ongoing}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Ellipse Classes="pulse" Width="7" Height="7" Fill="{StaticResource RedBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="ONGOING" Foreground="{StaticResource RedBrush}" />
                        </StackPanel>
                      </Border>
                      <TextBlock Text="{Binding Severity}" Foreground="{Binding Accent}" FontSize="10.5" FontWeight="Bold" LetterSpacing="1" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Category}" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RootCause}" Foreground="#C9D8F2" FontSize="13" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                      <TextBlock Text="Confidence" Classes="caption" VerticalAlignment="Center" />
                      <c:MeterBar Width="160" Height="6" Fraction="{Binding Confidence}" BarBrush="{Binding ConfidenceBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ConfidenceText}" Foreground="{Binding ConfidenceBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="·" Classes="faint" VerticalAlignment="Center" IsVisible="{Binding HasLink}" />
                      <TextBlock Text="{Binding LinkText}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding HasLink}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,6,0,0" IsVisible="{Binding HasEvidence}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Grid ColumnDefinitions="14,*" Margin="0,1">
                            <Ellipse Width="4" Height="4" Fill="{StaticResource CyanBrush}" VerticalAlignment="Top" Margin="2,7,0,0" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{Binding}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                      <Button Classes="link" Command="{Binding ToggleExpandCommand}" IsVisible="{Binding HasAffected}" FontSize="12.5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding AffectedText}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding ExpandText, StringFormat='({0})'}" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Classes="link" Command="{Binding OpenPcapCommand}" IsVisible="{Binding HasPcap}" FontSize="12.5" ToolTip.Tip="{Binding Incident.PcapPath}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Path Classes="icon" Data="{StaticResource IconRecord}" Stroke="{StaticResource MagentaBrush}" Width="12" Height="12" />
                          <TextBlock Text="open pcap" Foreground="{StaticResource MagentaBrush}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding PcapName}" Classes="caption" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding AffectedNames}" IsVisible="{Binding IsExpanded}" Margin="0,2,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border Classes="chip" Background="#1AFF3D5A" BorderBrush="#55FF3D5A">
                            <TextBlock Text="{Binding}" FontSize="11.5" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3" MinWidth="130">
                    <TextBlock Text="DURATION" Classes="caption" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Duration}" FontSize="17" FontWeight="SemiBold" Foreground="{Binding Accent}" HorizontalAlignment="Right" />
                    <TextBlock Classes="caption" HorizontalAlignment="Right">
                      <Run Text="{Binding StartText}" /><Run Text=" → " /><Run Text="{Binding EndText}" />
                    </TextBlock>
                    <Button Classes="ghost" Padding="10,4" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Right" IsVisible="{Binding HasSuspect}"
                            Command="{Binding ShowSuspectCommand}" ToolTip.Tip="Show the suspect on the spider web">
                      <TextBlock Text="{Binding SuspectText}" MaxWidth="200" TextTrimming="CharacterEllipsis" Foreground="{StaticResource CyanBrush}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- raw signals -->
      <Border Classes="card" IsVisible="{Binding HasSignals}">
        <StackPanel>
          <TextBlock Text="LIVE DIAGNOSTIC SIGNALS" Classes="section" Margin="0,0,0,2" />
          <TextBlock Text="What the monitors observed — the fault locator correlates these into the incidents above." Classes="caption" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Signals}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SignalRow">
                <Grid ColumnDefinitions="78,16,170,*,170" Margin="0,2">
                  <TextBlock Text="{Binding Time}" Classes="mono dim" VerticalAlignment="Center" />
                  <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="{Binding Brush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding Source}" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
