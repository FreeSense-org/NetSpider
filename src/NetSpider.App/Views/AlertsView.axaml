<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSpider.App.ViewModels"
             x:Class="NetSpider.App.Views.AlertsView"
             x:DataType="vm:AlertsViewModel">
  <DockPanel Margin="18,14,18,14">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,12">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Alerts" Classes="h1" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding CriticalCount, StringFormat='{}{0} critical'}" Foreground="{StaticResource RedBrush}" FontSize="12" />
          <TextBlock Text="{Binding WarningCount, StringFormat='{}{0} warnings'}" Foreground="{StaticResource AmberBrush}" FontSize="12" />
          <TextBlock Text="{Binding InfoCount, StringFormat='{}{0} info'}" Foreground="{StaticResource CyanBrush}" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <TextBox Grid.Column="2" Width="260" Text="{Binding SearchText}" Watermark="Filter alerts…" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Grid.Column="3" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Width="150" VerticalAlignment="Center" Margin="0,0,8,0" />
      <Button Grid.Column="4" Classes="danger" Command="{Binding ClearCommand}" Content="Clear" VerticalAlignment="Center" />
    </Grid>

    <Grid>
      <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
        <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource GreenBrush}" StrokeThickness="2" Width="44" Height="44" Stretch="Uniform" />
        <TextBlock Text="All quiet on the wire" Classes="h2" HorizontalAlignment="Center" />
        <TextBlock Text="Storms, loops, spoofing, rogue DHCP and new devices show up here." Classes="dim" HorizontalAlignment="Center" />
      </StackPanel>

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AlertRow">
              <Grid ColumnDefinitions="78,26,*" Margin="0,0,0,0">
                <!-- time column -->
                <StackPanel HorizontalAlignment="Right" Margin="0,12,10,0">
                  <TextBlock Text="{Binding Time}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Classes="mono" />
                  <TextBlock Text="{Binding Date}" Classes="caption" HorizontalAlignment="Right" />
                </StackPanel>
                <!-- timeline rail -->
                <Panel Grid.Column="1">
                  <Rectangle Width="2" Fill="#1E2B47" HorizontalAlignment="Center" />
                  <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Accent}" VerticalAlignment="Top" Margin="0,16,0,0"
                          BorderBrush="#070B14" BorderThickness="3" />
                </Panel>
                <!-- card -->
                <Border Grid.Column="2" Classes="card" Padding="14,10" Margin="10,6,0,6" BorderBrush="{Binding AccentSoft}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Classes="icon" Data="{Binding Icon}" Stroke="{Binding Accent}" Width="20" Height="20" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="12,0" Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Severity}" Foreground="{Binding Accent}" FontSize="10.5" FontWeight="Bold" LetterSpacing="1" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Kind}" Classes="caption" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RateText}" IsVisible="{Binding HasRate}" Foreground="{StaticResource MagentaBrush}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Details}" Classes="dim" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                      <Button Classes="ghost" Command="{Binding ShowSourceCommand}" IsVisible="{Binding HasSource}" Padding="10,4" FontSize="12"
                              ToolTip.Tip="Show this device in the web">
                        <TextBlock Text="{Binding SourceText}" MaxWidth="240" TextTrimming="CharacterEllipsis" Foreground="{StaticResource CyanBrush}" />
                      </Button>
                      <TextBlock Text="{Binding Ago}" Classes="caption" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
