<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetSpider.App.ViewModels"
             xmlns:c="using:NetSpider.App.Controls"
             x:Class="NetSpider.App.Views.WebView"
             x:DataType="vm:WebViewModel">
  <Grid>
    <c:NetworkWebControl x:Name="Graph" TopInset="104"
                         Engine="{Binding Engine}"
                         Mode="{Binding Mode}"
                         SelectedDevice="{Binding Selection.Selected, Mode=TwoWay}"
                         SearchText="{Binding SearchText}"
                         VlanFilter="{Binding VlanFilter}"
                         HiddenGroups="{Binding HiddenGroups}"
                         ShowMac="{Binding ShowMac}"
                         Animations="{Binding Animations}" />

    <!-- floating toolbar -->
    <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="14,12,14,0" Padding="10,8" CornerRadius="14"
            Background="#D90B1222" BorderBrush="{StaticResource BorderBrushNeon}" BorderThickness="1" BoxShadow="0 8 26 0 #88000000">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">
        <Border Classes="segmented" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton Classes="seg" GroupName="mode" IsChecked="{Binding IsWebMode}" ToolTip.Tip="Force-directed spider web around the gateway">
              <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconWeb}" Width="13" /><TextBlock Text="Spider Web" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="seg" GroupName="mode" IsChecked="{Binding IsTreeMode}" ToolTip.Tip="Top-down hierarchy">
              <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="M12,3 V9 M12,9 H5 V15 M12,9 H19 V15 M12,9 V15" Width="13" /><TextBlock Text="Hierarchy Tree" /></StackPanel>
            </RadioButton>
            <RadioButton Classes="seg" GroupName="mode" IsChecked="{Binding IsPortsMode}" ToolTip.Tip="Patch-panel view of managed switches">
              <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="M3,7 H21 V17 H3 Z M6,10 H9 V14 H6 Z M11,10 H14 V14 H11 Z M16,10 H19 V14 H16 Z" Width="13" /><TextBlock Text="Port Matrix" /></StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>

        <TextBox Grid.Column="1" Width="250" Margin="10,0" Text="{Binding SearchText}" Watermark="Search name, IP, MAC, vendor…" VerticalAlignment="Center">
          <TextBox.InnerLeftContent>
            <Path Classes="icon" Data="{StaticResource IconSearch}" Stroke="{StaticResource TextDimBrush}" Width="13" Margin="8,0,0,0" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="icon" Command="{Binding ClearSearchCommand}" Padding="4" Margin="0,0,4,0"><Path Classes="icon" Data="{StaticResource IconClose}" Width="9" /></Button>
          </TextBox.InnerRightContent>
        </TextBox>

        <!-- filter chips -->
        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding Chips}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FilterChip">
                  <ToggleButton Classes="chip" IsChecked="{Binding IsHidden}" Content="{Binding Label}" ToolTip.Tip="Click to hide / show this device group" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ComboBox ItemsSource="{Binding VlanOptions}" SelectedItem="{Binding SelectedVlan}" MinWidth="120" Margin="4,0,0,0" FontSize="12" ToolTip.Tip="Filter by VLAN" />
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" VerticalAlignment="Center">
          <ToggleButton Classes="chip" IsChecked="{Binding !ShowMac}" Content="MAC" ToolTip.Tip="Show MAC addresses on nodes" />
          <ToggleButton Classes="chip" IsChecked="{Binding !Animations}" Content="Motion" ToolTip.Tip="Animations (pulses, particles, packet rain)" />
          <Button Classes="icon" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (−)"><Path Classes="icon" Data="M5,12 H19" Width="13" /></Button>
          <Button Classes="icon" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (+)"><Path Classes="icon" Data="M5,12 H19 M12,5 V19" Width="13" /></Button>
          <Button Classes="accent" Command="{Binding FitCommand}" Padding="10,5" ToolTip.Tip="Fit everything (F)">
            <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="icon" Data="{StaticResource IconFit}" Width="12" /><TextBlock Text="Fit" FontSize="12.5" /></StackPanel>
          </Button>
          <Button Classes="icon" Command="{Binding ResetPinsCommand}" ToolTip.Tip="Unpin all dragged nodes">
            <Path Classes="icon" Data="M12,3 L15,9 L21,10 L16.5,14.5 L17.5,21 L12,18 L6.5,21 L7.5,14.5 L3,10 L9,9 Z" Width="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- hint -->
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,14" Padding="12,6" CornerRadius="10" Background="#B30B1222"
            BorderBrush="{StaticResource BorderBrushNeon}" BorderThickness="1" IsHitTestVisible="False">
      <TextBlock Text="{Binding ModeHint}" FontSize="11.5" Classes="dim" />
    </Border>

    <!-- empty state -->
    <Border IsVisible="{Binding !HasDevices}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="card glow" Padding="34,28" MaxWidth="520">
      <StackPanel Spacing="10" HorizontalAlignment="Center">
        <Path Data="{StaticResource IconSpider}" Stroke="{StaticResource AccentGradient}" StrokeThickness="1.4" Width="70" Height="70" Stretch="Uniform"
              StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" />
        <TextBlock Text="The web is empty — for now" Classes="h1" HorizontalAlignment="Center" />
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Classes="dim"
                   Text="Pick your adapter and press Start monitoring, then Full scan to spin the web. Or flip the Demo network switch in the top bar to explore a simulated home/office network with ~40 devices." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
