<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- palette -->
      <Color x:Key="BgColor">#070B14</Color>
      <Color x:Key="PanelColor">#0D1424</Color>
      <Color x:Key="PanelLightColor">#16213A</Color>
      <Color x:Key="BorderColor">#1E2B47</Color>
      <Color x:Key="CyanColor">#00E5FF</Color>
      <Color x:Key="MagentaColor">#FF2BD6</Color>
      <Color x:Key="GreenColor">#3DFF8B</Color>
      <Color x:Key="AmberColor">#FFC23D</Color>
      <Color x:Key="RedColor">#FF3D5A</Color>
      <Color x:Key="TextColor">#E8F1FF</Color>
      <Color x:Key="TextDimColor">#8A9BB8</Color>
      <Color x:Key="TextFaintColor">#56657F</Color>

      <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}" />
      <SolidColorBrush x:Key="BorderBrushNeon" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
      <SolidColorBrush x:Key="MagentaBrush" Color="{StaticResource MagentaColor}" />
      <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
      <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
      <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
      <SolidColorBrush x:Key="CyanSoftBrush" Color="#2200E5FF" />
      <SolidColorBrush x:Key="RowHoverBrush" Color="#1400E5FF" />

      <LinearGradientBrush x:Key="NavBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#0B1222" Offset="0" />
        <GradientStop Color="#070B14" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#00E5FF" Offset="0" />
        <GradientStop Color="#7A5CFF" Offset="0.6" />
        <GradientStop Color="#FF2BD6" Offset="1" />
      </LinearGradientBrush>

      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

      <!-- stroke icons (24x24) -->
      <StreamGeometry x:Key="IconWeb">M12,2 L12,22 M2,12 L22,12 M4.9,4.9 L19.1,19.1 M19.1,4.9 L4.9,19.1 M12,6.5 L15.9,8.1 L17.5,12 L15.9,15.9 L12,17.5 L8.1,15.9 L6.5,12 L8.1,8.1 Z M12,9.5 L13.8,10.2 L14.5,12 L13.8,13.8 L12,14.5 L10.2,13.8 L9.5,12 L10.2,10.2 Z</StreamGeometry>
      <StreamGeometry x:Key="IconDevices">M3,4 H21 V15 H3 Z M8,20 H16 M12,15 V20</StreamGeometry>
      <StreamGeometry x:Key="IconAlerts">M6,16 V11 C6,7.7 8.7,5 12,5 C15.3,5 18,7.7 18,11 V16 L20,18 H4 Z M10,21 H14 M12,3 V5</StreamGeometry>
      <StreamGeometry x:Key="IconGlobe">M12,3 C17,3 21,7 21,12 C21,17 17,21 12,21 C7,21 3,17 3,12 C3,7 7,3 12,3 Z M3,12 H21 M12,3 C9.5,5.5 8.5,8.5 8.5,12 C8.5,15.5 9.5,18.5 12,21 M12,3 C14.5,5.5 15.5,8.5 15.5,12 C15.5,15.5 14.5,18.5 12,21 M5,7.5 H19 M5,16.5 H19</StreamGeometry>
      <StreamGeometry x:Key="IconTraffic">M2,12 H6 L9,4 L13,20 L16,12 H22</StreamGeometry>
      <StreamGeometry x:Key="IconWifi">M2,9 C7.5,4 16.5,4 22,9 M5,12.5 C9,9 15,9 19,12.5 M8.5,16 C10.5,14.3 13.5,14.3 15.5,16 M12,19.5 L12,19.6</StreamGeometry>
      <StreamGeometry x:Key="IconSegments">M12,3 L22,8 L12,13 L2,8 Z M2,12 L12,17 L22,12 M2,16 L12,21 L22,16</StreamGeometry>
      <StreamGeometry x:Key="IconHealth">M12,20 L4.5,12.8 C2.5,10.8 2.5,7.6 4.5,5.8 C6.5,4 9.6,4.3 11.2,6.4 L12,7.4 L12.8,6.4 C14.4,4.3 17.5,4 19.5,5.8 C21.5,7.6 21.5,10.8 19.5,12.8 Z M6,12 H9 L10.5,9.5 L13,14 L14.5,12 H18</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M4,6 H20 M4,12 H20 M4,18 H20 M8,4 V8 M16,10 V14 M10,16 V20</StreamGeometry>
      <StreamGeometry x:Key="IconPath">M5,18 C5,19.1 4.1,20 3,20 C1.9,20 1,19.1 1,18 C1,16.9 1.9,16 3,16 C4.1,16 5,16.9 5,18 Z M23,6 C23,7.1 22.1,8 21,8 C19.9,8 19,7.1 19,6 C19,4.9 19.9,4 21,4 C22.1,4 23,4.9 23,6 Z M5,18 H9 L12,9 L15,15 L18,6 H19 M12,9 V9.1</StreamGeometry>
      <StreamGeometry x:Key="IconIncident">M12,3 C17,3 21,7 21,12 C21,17 17,21 12,21 C7,21 3,17 3,12 C3,7 7,3 12,3 Z M12,7 V12 L15,14 M3,12 H5 M19,12 H21</StreamGeometry>
      <StreamGeometry x:Key="IconStorm">M13,2 L5,13 H11 L10,22 L19,10 H13 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCable">M4,20 C4,14 8,14 10,12 C12,10 12,6 16,6 M16,3 H21 V9 H16 Z M17.5,3 V1.5 M19.5,3 V1.5 M2,20 H6</StreamGeometry>
      <StreamGeometry x:Key="IconPort">M4,6 H20 V18 H4 Z M8,18 V14 H16 V18 M9,10 H10 M12,10 H13 M15,10 H16</StreamGeometry>
      <StreamGeometry x:Key="IconRouterBox">M3,13 H21 V19 H3 Z M7,16 H7.1 M10,16 H10.1 M8,13 L5,6 M16,13 L19,6 M14,16 H18</StreamGeometry>
      <StreamGeometry x:Key="IconLoop">M17,7 C19.8,7 22,9.2 22,12 C22,14.8 19.8,17 17,17 C13,17 11,7 7,7 C4.2,7 2,9.2 2,12 C2,14.8 4.2,17 7,17 C11,17 13,7 17,7 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRecord">M12,4 C16.4,4 20,7.6 20,12 C20,16.4 16.4,20 12,20 C7.6,20 4,16.4 4,12 C4,7.6 7.6,4 12,4 Z M12,9 C13.7,9 15,10.3 15,12 C15,13.7 13.7,15 12,15 C10.3,15 9,13.7 9,12 C9,10.3 10.3,9 12,9 Z</StreamGeometry>
      <StreamGeometry x:Key="IconCopy">M9,9 H20 V20 H9 Z M5,15 H4 V4 H15 V5</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M20,12 A8,8 0 1 1 17.7,6.3 M20,4 V8 H16</StreamGeometry>
      <StreamGeometry x:Key="IconPlay">M7,4 L19,12 L7,20 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStop">M6,6 H18 V18 H6 Z</StreamGeometry>
      <StreamGeometry x:Key="IconScan">M3,8 V3 H8 M16,3 H21 V8 M21,16 V21 H16 M8,21 H3 V16 M7,12 H17</StreamGeometry>
      <StreamGeometry x:Key="IconExport">M12,3 V15 M7,10 L12,15 L17,10 M4,17 V21 H20 V17</StreamGeometry>
      <StreamGeometry x:Key="IconFit">M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15</StreamGeometry>
      <StreamGeometry x:Key="IconSearch">M10.5,4 C14.1,4 17,6.9 17,10.5 C17,14.1 14.1,17 10.5,17 C6.9,17 4,14.1 4,10.5 C4,6.9 6.9,4 10.5,4 Z M15.5,15.5 L21,21</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
      <StreamGeometry x:Key="IconChevronRight">M9,5 L16,12 L9,19</StreamGeometry>
      <StreamGeometry x:Key="IconChevronLeft">M15,5 L8,12 L15,19</StreamGeometry>
      <StreamGeometry x:Key="IconWarn">M12,3 L22,20 H2 Z M12,9 V14 M12,17 V17.2</StreamGeometry>
      <StreamGeometry x:Key="IconInfo">M12,3 C17,3 21,7 21,12 C21,17 17,21 12,21 C7,21 3,17 3,12 C3,7 7,3 12,3 Z M12,11 V16 M12,8 V8.2</StreamGeometry>
      <StreamGeometry x:Key="IconCritical">M8.3,3 H15.7 L21,8.3 V15.7 L15.7,21 H8.3 L3,15.7 V8.3 Z M12,7.5 V13 M12,16 V16.2</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M5,12.5 L10,17.5 L19,7</StreamGeometry>
      <StreamGeometry x:Key="IconShield">M12,3 L19,6 V11 C19,16 15.5,19.5 12,21 C8.5,19.5 5,16 5,11 V6 Z</StreamGeometry>
      <!-- changelog category badges (Controls/ChangelogControls.cs): Breaking=IconWarn, Security=IconShield -->
      <StreamGeometry x:Key="IconSparkles">M10,3 L11.7,8.3 L17,10 L11.7,11.7 L10,17 L8.3,11.7 L3,10 L8.3,8.3 Z M18,14 L18.8,16.2 L21,17 L18.8,17.8 L18,20 L17.2,17.8 L15,17 L17.2,16.2 Z M18,3 V6 M16.5,4.5 H19.5</StreamGeometry>
      <StreamGeometry x:Key="IconArrowUp">M12,20 V5 M6,11 L12,5 L18,11</StreamGeometry>
      <StreamGeometry x:Key="IconBug">M12,7.5 C14.8,7.5 16.5,10 16.5,13.5 C16.5,17 14.8,20.5 12,20.5 C9.2,20.5 7.5,17 7.5,13.5 C7.5,10 9.2,7.5 12,7.5 Z M9.6,8.2 C9.6,6.3 10.6,4.5 12,4.5 C13.4,4.5 14.4,6.3 14.4,8.2 M12,11.5 V20.5 M7.5,13 H4 M16.5,13 H20 M7.9,17 L4.8,19 M16.1,17 L19.2,19 M8.3,10 L5.5,8 M15.7,10 L18.5,8</StreamGeometry>
      <StreamGeometry x:Key="IconMinusCircle">M12,3 C17,3 21,7 21,12 C21,17 17,21 12,21 C7,21 3,17 3,12 C3,7 7,3 12,3 Z M8,12 H16</StreamGeometry>
      <StreamGeometry x:Key="IconHourglass">M7,3 H17 M7,21 H17 M8,3 C8,8.5 16,8.5 16,12 C16,15.5 8,15.5 8,21 M16,3 C16,8.5 8,8.5 8,12 C8,15.5 16,15.5 16,21</StreamGeometry>
      <StreamGeometry x:Key="IconSpider">M12,8.5 C13.7,8.5 15,9.8 15,11.5 C15,13.2 13.7,14.5 12,14.5 C10.3,14.5 9,13.2 9,11.5 C9,9.8 10.3,8.5 12,8.5 Z M12,14.5 C13.4,14.5 14.3,15.8 14.3,17.4 C14.3,19.2 13.3,20.5 12,20.5 C10.7,20.5 9.7,19.2 9.7,17.4 C9.7,15.8 10.6,14.5 12,14.5 Z M9.3,10 L6,6.5 L3,7.5 M9,12 L4.5,11 L2,13 M9.5,14 L6,16.5 L5,20 M14.7,10 L18,6.5 L21,7.5 M15,12 L19.5,11 L22,13 M14.5,14 L18,16.5 L19,20 M12,8.5 V2</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ===== base ===== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- ===== text styles ===== -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Margin" Value="0,14,0,6" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ===== cards ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeon}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
  </Style>
  <Style Selector="Border.glow">
    <Setter Property="BorderBrush" Value="#5500E5FF" />
    <Setter Property="BoxShadow" Value="0 0 22 0 #3300E5FF" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="#1A00E5FF" />
    <Setter Property="BorderBrush" Value="#3300E5FF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.pill.stat">
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.pill.stat TextBlock">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="#1A00E5FF" />
    <Setter Property="BorderBrush" Value="#3300E5FF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A00E5FF" />
    <Setter Property="BorderBrush" Value="#8800E5FF" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.demo">
    <Setter Property="Background" Value="#14FF2BD6" />
    <Setter Property="BorderBrush" Value="#66FF2BD6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#FFC4F3" />
    <Setter Property="Padding" Value="11,6" />
  </Style>
  <Style Selector="ToggleButton.demo:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#55FF2BD6" />
    <Setter Property="BorderBrush" Value="#FF2BD6" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BoxShadow" Value="0 0 16 0 #88FF2BD6" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ===== banners ===== -->
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="12,8,12,0" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.banner.warn">
    <Setter Property="Background" Value="#22FFC23D" />
    <Setter Property="BorderBrush" Value="#88FFC23D" />
  </Style>
  <Style Selector="Border.banner.error">
    <Setter Property="Background" Value="#26FF3D5A" />
    <Setter Property="BorderBrush" Value="#99FF3D5A" />
  </Style>
  <Style Selector="Border.banner.info">
    <Setter Property="Background" Value="#1800E5FF" />
    <Setter Property="BorderBrush" Value="#6600E5FF" />
  </Style>

  <!-- ===== icons ===== -->
  <Style Selector="Path.icon">
    <!-- explicit colours per context below; a binding to the parent presenter's Foreground resolved to null -->
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextDimBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource CyanBrush}" />
  </Style>
  <Style Selector="Button.accent Path.icon">
    <Setter Property="Stroke" Value="#B9F9FF" />
  </Style>
  <Style Selector="Button.magenta Path.icon">
    <Setter Property="Stroke" Value="#FFC4F3" />
  </Style>
  <Style Selector="Button.ghost Path.icon, Button.icon Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextDimBrush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover Path.icon, Button.icon:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource CyanBrush}" />
  </Style>
  <Style Selector="Button:disabled Path.icon">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- ===== buttons ===== -->
  <Style Selector="Button, ToggleButton, SplitButton, DropDownButton">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="#2200E5FF" />
    <Setter Property="BorderBrush" Value="#AA00E5FF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#B9F9FF" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#4400E5FF" />
    <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BoxShadow" Value="0 0 16 0 #6600E5FF" />
  </Style>
  <Style Selector="Button.magenta">
    <Setter Property="Background" Value="#22FF2BD6" />
    <Setter Property="BorderBrush" Value="#AAFF2BD6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#FFC4F3" />
  </Style>
  <Style Selector="Button.magenta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#44FF2BD6" />
    <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BoxShadow" Value="0 0 16 0 #66FF2BD6" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#22FF3D5A" />
    <Setter Property="BorderBrush" Value="#AAFF3D5A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#FFC9D1" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeon}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- segmented control (RadioButtons in a Border.segmented) -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="#0A1020" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeon}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="RadioButton.seg">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" CornerRadius="8" Padding="12,5" Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.seg:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="#1200E5FF" />
  </Style>
  <Style Selector="RadioButton.seg:checked /template/ Border#bd">
    <Setter Property="Background" Value="#3300E5FF" />
    <Setter Property="BoxShadow" Value="0 0 12 0 #5500E5FF" />
  </Style>
  <Style Selector="RadioButton.seg:checked">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- filter chips -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Background" Value="#1A00E5FF" />
    <Setter Property="BorderBrush" Value="#5500E5FF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#B9F9FF" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeon}" />
    <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
  </Style>

  <!-- ===== nav ===== -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1200E5FF" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2600E5FF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="#6600E5FF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 0 18 0 #3300E5FF" />
  </Style>

  <!-- ===== inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="#0A1020" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeon}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
    <Setter Property="Background" Value="#0C1528" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="#0A1020" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeon}" />
  </Style>
  <!-- NumericUpDown: one rounded frame (on the ButtonSpinner); the inner TextBox must not draw its own border,
       and the spin buttons are compact chevrons instead of wide Fluent repeat buttons. -->
  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="#0A1020" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeon}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="ShowButtonSpinner" Value="False" />
    <Setter Property="AllowSpin" Value="True" />
    <Setter Property="ToolTip.Tip" Value="Type a value, or use the mouse wheel / arrow keys" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown:focus-within /template/ ButtonSpinner">
    <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton#PART_IncreaseButton, ButtonSpinner /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Width" Value="22" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2200E5FF" />
    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton > PathIcon">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
  </Style>

  <!-- chip editors (e.g. SNMP communities): text vertically centred, no inner frame -->
  <Style Selector="Border.chip TextBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.chip TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.chip Button">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- pulsing status dots (ongoing incidents, storm level) -->
  <Style Selector="Ellipse.pulse, Border.pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.8" />
  </Style>
  <!-- compact table header cells -->
  <Style Selector="TextBlock.th">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="DataGridCell TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource AccentGradient}" />
    <Setter Property="Background" Value="#1A2235" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="#0D1526" />
    <Setter Property="BorderBrush" Value="#5500E5FF" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>

  <!-- ===== DataGrid ===== -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="#141E33" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="#0A1020" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="#2600E5FF" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="#1000E5FF" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <!-- ===== updater / About (nav "About" link, amber update chip) ===== -->
  <Style Selector="Button.navlink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,9" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.navlink Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextDimBrush}" />
  </Style>
  <Style Selector="Button.navlink TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
  </Style>
  <Style Selector="Button.navlink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1400E5FF" />
  </Style>
  <Style Selector="Button.navlink:pointerover Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.navlink:pointerover TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.pill.update">
    <Setter Property="Background" Value="#22FFC23D" />
    <Setter Property="BorderBrush" Value="#99FFC23D" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.pill.update:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#40FFC23D" />
    <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
  </Style>
</Styles>
